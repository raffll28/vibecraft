{
  "isOriginAllowed": [
    {
      "input": "http://localhost:4002",
      "expected": true
    },
    {
      "input": "http://localhost",
      "expected": true
    },
    {
      "input": "https://localhost:8443",
      "expected": true
    },
    {
      "input": "http://127.0.0.1:5173",
      "expected": true
    },
    {
      "input": "https://vibecraft.sh",
      "expected": false
    },
    {
      "input": "http://vibecraft.sh",
      "expected": false
    },
    {
      "input": "https://evil.vibecraft.sh",
      "expected": false
    },
    {
      "input": "https://vibecraft.sh.evil.com",
      "expected": false
    },
    {
      "input": "http://localhost.evil.com",
      "expected": false
    },
    {
      "input": "http://192.168.0.10:4002",
      "expected": false
    },
    {
      "input": "null",
      "expected": false
    },
    {
      "input": "not a url",
      "expected": false
    },
    {
      "input": "",
      "expected": false
    },
    {
      "input": null,
      "expected": false
    }
  ],
  "expandHome": [
    {
      "input": "~",
      "expected": "$HOME"
    },
    {
      "input": "~/a/b",
      "expected": "$HOME/a/b"
    },
    {
      "input": "~user/a",
      "expected": "~user/a"
    },
    {
      "input": "/abs/~/x",
      "expected": "/abs/~/x"
    },
    {
      "input": "rel/path",
      "expected": "rel/path"
    }
  ]
}
